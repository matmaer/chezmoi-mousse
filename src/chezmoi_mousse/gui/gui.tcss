/****************/
/* tcss classes */
/****************/

/* TODO implement vw and vh for screens and containers with docked components */
/* TODO, check scrollbar-gutter: stable */
# Valid scalar units are '%', 'fr', 'h', 'vh', 'vw', or 'w'

.add_tab_contents_view {
  border-top: $primary;
  border-title-align: center;
  border-title-style: bold;
}

.flat_button{
  background-tint: $primary-muted;
  background: $primary-muted;
  border-bottom: inner $primary-muted;
  border-left: none;
  border-right: none;
  border-top: inner $primary-muted;
  color: $text-muted;
  width: 100%;
  &:hover {
    color: $foreground;
  }
  &:focus {
    text-style: bold;
    color: $text-accent;
  }
  &.last_clicked_flat_btn {
    color: $text-accent;
    text-style: bold;
    &:hover {
      color: $text-accent;
    }
    &:focus {
      text-style: bold;
      color: $text-accent;
    }
  }
}

.flow_diagram {
  min-width: 78;
}

.op_btn_group {
  dock: bottom;
  height: 2;
  &>.operate_button {
    background-tint: $surface-lighten-1;
    background: $surface-lighten-1;
    border-top: wide $primary-darken-3;
    border-bottom: none;
    color: $primary-lighten-3;
    margin: 0 1;
    text-style: none;
    width: 1fr;
    &:hover {
      text-style: none;
      color: $accent;
      border-top: wide $accent-darken-3;
    }
    &:focus {
      text-style: none;
    }
  }
}

.left_side_vertical {
  margin-right: 2;
  width: auto;
  max-width: 33%;
  min-width: 18;
  &>.managed_tree {
    height: 1fr;
    min-width: 18;
    max-width: 100%;
    width: auto;
  }
  &>.refresh_button {
    background-tint: $surface-lighten-1;
    background: $surface-lighten-1;
    border-bottom: none;
    border-top: wide $surface-lighten-1;
    color: $primary-lighten-3;
    dock: bottom;
    height: 2;
    margin: 0 1;
    min-width: 18;
    text-style: none;
    width: 100%;
    &:hover {
      text-style: none;
      color: $accent-lighten-1;
    }
    &:focus {
      text-style: none;
    }
  }
  &>.directory_tree {
    border-top: $primary;
    border-title-align: center;
    border-title-style: bold;
    min-width: 18;
    width: auto;
    &>.directory-tree--folder {
      color: $primary-lighten-3;
      text-style: none;
    }
    &>.directory-tree--extension {
      text-style: none;
    }
    &>.directory-tree--hidden {
      text-style: none;
    }
    &>.directory-tree--file {
      color: $success-lighten-3;
      text-style: none;
    }
  }
}

.operate_pane {
  &>.operations_left {
    &>.dest_dir_button{
      background-tint: $primary-muted;
      background: $primary-muted;
      border-bottom: inner $primary-muted;
      border-top: inner $primary-muted;
      color: $text-muted;
      content-align: left middle;
      text-align: left;
      text-style: bold;
      width: 1fr;
      &:hover {
        color: $text-accent;
      }
      &:focus {
        text-style: bold;
      }
    }
    &>.refresh_button {
        background-tint: $surface-lighten-1;
        background: $surface-lighten-1;
        border-bottom: none;
        border-top: wide $surface-lighten-1;
        color: $primary-lighten-3;
        margin: 0 1;
        min-width: 18;
        text-style: none;
        width: 100%;
        &:hover {
          text-style: none;
          color: $accent-lighten-1;
        }
        &:focus {
          text-style: none;
        }
      }
  }
  
  &>.operations_middle {
    margin: 0 2;
  }
  
  &>.operations_right {
    &>.op_btn_vert_group {
      padding-top: 1;
      .operate_button {
        background-tint: $surface-lighten-1;
        background: $surface-lighten-1;
        border-bottom: wide $primary-darken-3;
        border-top: none;
        color: $text-primary;
        width: 1fr;
        &:hover {
          border-bottom: wide $accent-darken-3;
          color: $accent;
          text-style: none;
        }
        &:focus {
          text-style: none;
        }
      }
    }
    &>.switches_vert_group {
      background-tint: $surface;
      background: $surface;        
      padding-top: 1;
      .switch_with_label {
        padding: 0 0 1 2;
      }
    }

  }
}

RadioSet {
  background-tint: $surface;
  background: $surface;
  margin-bottom: 1;
  padding: 0 0 1 1;
  border: none;
}

RadioButton {
  padding-top: 1;
}

/**********************/
/* Type Selector tcss */
/**********************/

AnimatedFade, AppLog, CmdLog, ContentsView, DiffView {
  margin-bottom: 2;
}


CustomHeader {
  border-bottom: dashed $surface-lighten-3;
  color: $primary;
  height: 2;
  text-style: bold;
  &>.live_run_color {
    color: $warning;
  }
}

DirContentBtn {
  border: none;
}

DoctorTable {
  margin-bottom: 3;
}

FlatButtonsVertical {
  padding-right: 2;
  width: auto;
}

InfoVertical {
  width: 1fr;
  height: 1fr;
}


SwitchSlider {
  background-tint: $surface;
  background: $surface;
  border: round $primary;
  border-left: none;
  color: $foreground-darken-1;
  dock: bottom;
  layer: above;
  offset-x: -100%;
  margin-bottom: 4;
  padding: 0 1 0 2;
  transition: offset 380ms;
  width: auto;
  &.-visible {
    offset-x: 0%;
  }
  & HorizontalGroup {
    padding-bottom: 1;
    width: auto;
  }
}

TabButtons {
  height: 2;
  width: 100%;
  border-bottom: solid $primary;
  border-subtitle-align: center;
  border-subtitle-style: bold;

  &>.single_button_vertical {
    align: center middle;
  }
  .tab_button {
    border: none;
    min-width: 3;
    text-style: bold;
    color: $foreground 60%;
    &:hover {
      color: $foreground;
    }
    &:focus {
      text-style: bold;
      color: $text-accent 80%;
    }
    &.last_clicked_tab_btn {
      color: $text-accent 80%;
      text-style: bold;
      &:hover {
        color: $text-accent 80%;
      }
      &:focus {
        text-style: bold;
        color: $text-accent 80%;
      }
    }
  }
}

/***********************************/
/* textual default tcss overrides  */
/***********************************/

* {
  background-tint: $background;
  scrollbar-size-vertical: 1;
  scrollbar-background: $background;
  scrollbar-background-active: $background;
  scrollbar-background-hover: $background;
  scrollbar-corner-color: $background;
}

Collapsible {
  border-top: none;
  padding-bottom: 0;
  padding-left: 0;
  &> Contents {
    padding: 0 0 1 1;
  }
}

CollapsibleTitle {
  padding: 0;
  text-style: none;
  &:hover {
    text-style: bold;
  }
}

DataTable {
  &>.datatable--header {
    text-style: none;
  }
}

Footer {
  height: 2;
  border-top: wide $surface;
  background-tint: $surface;
  background: $surface;
}

Label{
  padding: 0 1;
  text-align: center;
  border-left: none;
  border-right: none;
  &.dest_dir_tree_label {
    background-tint: $background;
    background: $background;
    border-bottom: solid $primary;
    border-top: none;
    color: $primary-lighten-3;
    width: 100%;
  }
  &.flat_section_label {
    background-tint: $primary-muted;
    background: $primary-muted;
    border-bottom: wide $primary-muted;
    border-top: wide $primary-muted;
    color: $primary-lighten-3;
    width: 1fr;
  }
  &.sub_section_label {
    background-tint: $panel;
    background: $panel;
    border-bottom: wide $panel;
    border-top: wide $panel;
    color: $text-success;
    width: 1fr;
  }
  &.main_section_label {
    background-tint: $surface-lighten-1;
    background: $surface-lighten-1;
    border-bottom: inner $surface-lighten-1;
    border-top: inner $surface-lighten-1;
    color: $text-accent;
    width: 1fr;
  }
}

Static {
  &.added {
    background-tint: $success-muted;
    background: $success-muted;
    color: $text-success;
  }
  &.changed {
    background-tint: $warning-muted;
    background: $warning-muted;
    color: $text-warning;
  }
  &.context{
    background-tint: $surface;
    background: $surface;
    color: $text-disabled;
  }
  &.full_cmd {
    background-tint: $primary-muted;
    background: $primary-muted;
    color: $primary-lighten-3;
    text-align: center;
    width: 1fr;
  }
  &.info {
    border-top: inner $surface;
    border-bottom: inner $surface;
    background-tint: $surface;
    background: $surface;
    color: $text;
    padding: 0 1;
  }
  &.removed {
    background-tint: $error-muted;
    background: $error-muted;
    color: $text-error;
  }
  &.unhandled {
    /* only used for debugging by visualizing unhandled formatting conditions */
    background-tint: $error-darken-3;
    background: $error-darken-3;
    color: $foreground;
  }
}

Switch {
  background: $surface;
  background-tint: $surface;
  border: none;
  padding-right: 1;
  &>.switch--slider {
    color: $error-darken-3;
  }
  &.-on .switch--slider {
    color: $success-darken-2;
  }
  &:hover {
    &>.switch--slider {
      color: $error-darken-1;
    }
    &.-on>.switch--slider {
      color: $success-lighten-1;
    }
  }
  &:disabled {
    &>.switch--slider {
      color: $panel-lighten-3;
    }
  }
}

TabbedContent {
  /* center the tab buttons on top */
  & #tabs-list {
    align: center top;
  }
  & Tab {
    margin: 0 2;
  }
}

Tree {
  &>.tree--highlight-line {
    text-style: bold;
  }
  &>.tree--highlight {
    text-style: none;
  }
  &>.tree--guides {
    color: $primary-lighten-3;
  }
  &>.tree--guides-hover {
    color: $primary-lighten-3;
  }
  &>.tree--guides-selected {
    color: $primary-lighten-3;
  }
  &:focus {
    &>.tree--guides {
      color: $primary-lighten-3;
    }
    &>.tree--guides-hover {
      color: $primary-lighten-3;
    }
    &>.tree--guides-selected {
      color: $primary-lighten-3;
    }
  }
}


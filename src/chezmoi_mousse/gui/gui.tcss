/* width /height valid scalar units '%', 'fr', 'h', 'vh', 'vw', or 'w' */

.flow_diagram {
  min-width: 78;
}

.operate_pane {
  &>LeftSideVertical {
    max-width: 30%;
    width: auto;

    &>TreeBtnGroup {
      height: 3;
      width: 100%;
      min-width: 28;
    }

    &>OperateTree {
      height: 1fr;
      width: auto;
      max-width: 1fr;
      scrollbar-gutter: stable;
    }
  }

  &>MiddleVertical {
    margin: 0 1;
    height: 1fr;
  }

  &>RightSideVertical {
    width: 25;

    &>SwitchGroup {
      .switch_with_label {
        background-tint: $surface;
        background: $surface;
        border-bottom: inner $surface;
        border-top: inner $surface;
        padding-left: 2;
      }
    }
  }
}

.splash_log {
  min-height: 20;
  height: auto;
}

/**********************/
/* Type Selector tcss */
/**********************/

AnimatedFade {
  margin-bottom: 2;
}

DoctorTable {
  height: 1fr;
  margin-bottom: 1;

  &.datatable--header {
    text-style: none;
  }
}

LogsTab>ScrollableContainer {
  margin-bottom: 1;
}

SelectPaths>Collapsible {

  &>Contents {
    margin-top: 0;
  }

  Checkbox {
    background: $surface;
    background-tint: $surface;
    border: none;
    padding-left: 2;
    margin-right: 1;
    width: 1fr;

    &.select_all {
      background: $panel;
      background-tint: $panel;
      border-bottom: inner $panel;
      border-top: inner $panel;
      padding-left: 0;

      &>.toggle--button {
        background: $panel;
        background-tint: $panel;
      }

      &.-on>.toggle--button {
        background: $panel;
        background-tint: $panel;
      }

      &:focus>.toggle--button {
        background: $panel;
        background-tint: $panel;
      }

      &:hover>.toggle--button {
        background: $panel;
        background-tint: $panel;
      }

      &>.toggle--label {
        background: $panel;
        background-tint: $panel;
      }

      &:blur:hover {
        &>.toggle--label {
          background: $panel;
          background-tint: $panel;
        }
      }
    }
  }
}

FlatBtnGroup {
  padding-right: 1;
  width: auto;
}

OperateBtnGroup {
  dock: bottom;
}

OperateModal {
  align: center middle;

  &>Vertical {
    border: round $warning-darken-2;
    min-width: 70;
    max-width: 1fr;
    margin: 1 2 0 2;
    width: auto;

    .op_modal_collapsible {
      margin-bottom: 1;
    }
  }
}

/***********************************/
/* textual default tcss overrides  */
/***********************************/

* {
  background-tint: $background;
  scrollbar-size-vertical: 1;
  scrollbar-background: $background;
  scrollbar-background-active: $background;
  scrollbar-background-hover: $background;
  scrollbar-corner-color: $background;
}

Button {
  &.dest_dir_button {
    background-tint: $surface-lighten-1;
    background: $surface-lighten-1;
    border-bottom: inner $surface-lighten-1;
    border-top: inner $surface-lighten-1;
    color: $text-primary;
    text-style: none;
    width: 1fr;

    &:hover {
      background-tint: $surface-lighten-2;
      background: $surface-lighten-2;
      border-bottom: inner $surface-lighten-2;
      border-top: inner $surface-lighten-2;
      text-style: bold;
    }

    &:focus {
      text-style: bold;
    }
  }

  &.flat_btn {
    background: $primary-muted;
    background-tint: $primary-muted;
    border: none;
    border-bottom: inner $primary-muted;
    border-top: inner $primary-muted;
    color: $text-muted;

    &:hover {
      color: $foreground;
    }

    &:focus {
      text-style: bold;
      color: $text-accent;
    }

    &.last_clicked_flat_btn {
      color: $text-accent;
      text-style: bold;

      &:hover {
        color: $text-accent;
      }

      &:focus {
        text-style: bold;
        color: $text-accent;
      }
    }
  }

  &.operate_btn {
    background-tint: $surface-lighten-1;
    background: $surface-lighten-1;
    border-top: wide $primary-darken-3;
    border-bottom: inner $surface-lighten-1;
    color: $primary-lighten-3;
    margin: 0 1;
    text-style: none;
    width: 1fr;

    &:hover {
      text-style: none;
      color: $accent;
      border-top: wide $accent-darken-3;
    }

    &:focus {
      text-style: none;
    }
  }

  &.prompt_btn {
    background-tint: $panel;
    background: $panel;
    border-bottom: inner $panel;
    border-top: wide $panel-lighten-3;
    color: $foreground-darken-1;
    margin: 0 1;
    text-style: none;
    width: 1fr;

    &:hover {
      text-style: none;
      border-top: wide $foreground-darken-3;
      color: $accent;
    }

    &:focus {
      text-style: none;
    }
  }

  &.tree_op_button {
    background-tint: $surface-lighten-1;
    background: $surface-lighten-1;
    border-bottom: inner $surface-lighten-1;
    border-top: inner $surface-lighten-1;
    color: $accent;
    text-style: bold;
    width: 3;
    min-width: 3;

    &:hover {
      background-tint: $surface-lighten-2;
      background: $surface-lighten-2;
      border-bottom: inner $surface-lighten-2;
      border-top: inner $surface-lighten-2;
      text-style: bold;
    }

    &:focus {
      text-style: bold;
    }
  }
}

Collapsible {
  border-top: none;
  padding: 0;

  &>Contents {
    margin-right: 1;
    margin-top: 1;
    padding-left: 1;
  }
}

CollapsibleTitle {
  padding: 0;
  text-style: none;

  &:hover {
    text-style: bold;
  }
}

Footer {
  background-tint: $panel;
  background: $panel;
}


Label {
  padding: 0 1;
  text-align: center;
  border-left: none;
  border-right: none;
  width: 1fr;

  &.truth_label {
    width: 4fr;
    background-tint: $panel;
    background: $panel;
    border-bottom: wide $panel;
    color: $foreground-darken-1;
  }

  &.true_label {
    height: 100%;
    width: 1fr;
    background-tint: $success-muted;
    background: $success-muted;
    border-bottom: wide $success-muted;
    color: $text-success;
  }

  &.false_label {
    height: 100%;
    width: 1fr;
    background-tint: $error-muted;
    background: $error-muted;
    border-bottom: wide $error-muted;
    color: $text-error;
  }
}

RadioSet {
  border: none;
  border-bottom: inner $surface;
  background: $surface;
  background-tint: $surface;

  &:blur {
    &>RadioButton.-selected {
      &>.toggle--label {
        text-style: bold;
        color: $text-success;
        background: $surface;
        background-tint: $surface;
      }
    }
  }

  &:focus {
    &>RadioButton.-selected {
      &>.toggle--label {
        background: $surface;
        background-tint: $surface;
        color: $text-success;
        text-style: $block-cursor-text-style;
      }
    }
  }

}

ToggleButton {
  background: $surface;
  background-tint: $surface;
  text-style: none;

  &>.toggle--button {
    background: $surface;
    background-tint: $surface;
  }

  &.-on>.toggle--button {
    color: $text-success;
    text-style: bold;
  }

  &:hover>.toggle--button {
    text-style: bold;
  }

  &:blur:hover {
    &>.toggle--label {
      text-style: bold;
    }
  }
}

Toast {
  background-tint: $surface-lighten-1;
  background: $surface-lighten-1;
  width: auto;
}

Static {
  &.added {
    background-tint: $success-muted;
    background: $success-muted;
    color: $text-success;
  }

  &.context {
    background-tint: $surface;
    background: $surface;
    color: $text-disabled;
  }

  &.cmd_output {
    border-bottom: inner $surface;
    background-tint: $surface;
    background: $surface;
    color: $text;
    padding: 0 1;
  }

  &.blue_label {
    background-tint: $primary-muted;
    background: $primary-muted;
    border-bottom: wide $primary-muted;
    color: $primary-lighten-3;
    text-align: center;
    width: 1fr;
  }

  &.green_label {
    background-tint: $panel;
    background: $panel;
    border-bottom: wide $panel;
    color: $text-success;
    text-align: center;
    width: 1fr;
  }

  &.main_label {
    background-tint: $surface-lighten-1;
    background: $surface-lighten-1;
    border-bottom: inner $surface-lighten-1;
    border-top: inner $surface-lighten-1;
    color: $text-accent;
    text-align: center;
    width: 1fr;
  }

  &.info {
    border-top: inner $surface;
    border-bottom: inner $surface;
    background-tint: $surface;
    background: $surface;
    padding: 0 1;
  }

  &.removed {
    background-tint: $error-muted;
    background: $error-muted;
    color: $text-error;
  }

}

Switch {
  background: $surface;
  background-tint: $surface;
  border: none;
  padding-right: 1;

  &>.switch--slider {
    color: $error-darken-3;
  }

  &.-on .switch--slider {
    color: $success-darken-2;
  }

  &:hover {
    &>.switch--slider {
      color: $error-darken-1;
    }

    &.-on>.switch--slider {
      color: $success-lighten-1;
    }
  }

  &:disabled {
    &>.switch--slider {
      color: $panel-lighten-3;
    }

    &:hover {
      &>.switch--slider {
        color: $panel-lighten-3;
      }

      &.-on>.switch--slider {
        color: $panel-lighten-3;
      }
    }
  }
}

TabbedContent {
  border-top: dashed $panel;

  /* center the tab buttons on top */
  & #tabs-list {
    align: center top;
  }

  & Tab {
    margin: 0 2;
  }
}

Tree {
  &>.tree--label {
    text-style: none;
  }

  &>.tree--highlight {
    text-style: bold;
  }

  &>.tree--guides {
    color: $primary-lighten-3;
  }

  &>.tree--guides-hover {
    color: $primary-lighten-3;
  }

  &>.tree--guides-selected {
    color: $primary-lighten-3;
  }

  &:focus {
    &>.tree--guides {
      color: $primary-lighten-3;
    }

    &>.tree--guides-hover {
      color: $primary-lighten-3;
    }

    &>.tree--guides-selected {
      color: $primary-lighten-3;
    }
  }
}